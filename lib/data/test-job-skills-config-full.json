  "prestart_modal": {
    "title": "Test pracovných zručností",
    "subtitle": "Prečítajte si prosím dôležité informácie pred začatím testu",
    "privacy_statements": [
      {
        "id": "data-collection",
        "title": "Zhromažďovanie údajov",
        "content": "Počas testu budeme zaznamenávať vaše odpovede, čas strávený na každej otázke a celkové výsledky. Tieto údaje budú použité výhradne na vyhodnotenie vašich pracovných zručností."
      },
      {
        "id": "data-usage",
        "title": "Použitie údajov",
        "content": "Vaše výsledky budú zdieľané s potenciálnymi zamestnávateľmi, ktorí si prezerajú váš profil. Údaje nebudú predané tretím stranám na marketingové účely."
      },
      {
        "id": "data-retention",
        "title": "Uchovávanie údajov",
        "content": "Výsledky testov budú uložené vo vašom profile po dobu 12 mesiacov. Kedykoľvek môžete požiadať o vymazanie svojich údajov."
      }
    ],
    "checklist": [

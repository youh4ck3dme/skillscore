{
  "module": "it-cv-skills-routing",
  "version": "v1",
  "start_route": {
    "pattern": "/tests/{slug}",
    "query": {
      "level": "{level}",
      "variant": "{variant}"
    }
  },
  "levels": [1, 2, 3, 4],
  "normalize": {
    "skill_aliases": {
      "excel": ["excel", "ms excel", "microsoft excel", "calc", "tabuľky", "tabulky"],
      "word": ["word", "ms word", "microsoft word", "dokumenty", "docs (ms)"],
      "powerpoint": ["powerpoint", "ms powerpoint", "microsoft powerpoint", "ppt", "prezentacie", "prezentácie"],
      "outlook": ["outlook", "ms outlook", "email outlook", "pošta outlook"],
      "google-sheets": ["google sheets", "g sheets", "gsheets", "tabuľky google", "tabulky google"],
      "google-docs": ["google docs", "g docs", "gdocs", "dokumenty google"],
      "google-slides": ["google slides", "g slides", "gslides", "prezentacie google", "prezentácie google"],
      "sql": ["sql", "mysql", "postgres", "postgresql", "mssql"],
      "power-bi": ["power bi", "pbi"],
      "tableau": ["tableau"],
      "teams": ["teams", "microsoft teams", "ms teams"]
    },
    "level_aliases": {
      "1": ["1", "zaciatocnik", "začiatočník", "beginner", "junior"],
      "2": ["2", "mierne pokrocily", "mierne pokročilý", "pre-intermediate"],
      "3": ["3", "pokrocily", "advanced", "senior"],
      "4": ["4", "expert", "expertise", "lead"]
    }
  },
  "policy": {
    "if_missing_skill": "ignore",
    "if_missing_level": "show_level_picker",
    "default_level": 2,
    "progression": {
      "enabled": true,
      "rule": "3_up_3_down",
      "success_streak_required": 3,
      "fail_streak_required": 3,
      "messages_ref": "it_user_messages_SK_v1.json"
    }
  },
